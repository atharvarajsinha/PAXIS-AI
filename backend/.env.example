# --- AI providers -----------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_API_KEY=
GROQ_MODEL=
SERPER_API_KEY=your_serper_api_key

# --- Database ---------------------------------------------------------------
DB_NAME=ai_learning_path
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=0
DB_CONNECT_TIMEOUT=10

# --- Django -----------------------------------------------------------------
DJANGO_SECRET_KEY=your_django_secret_key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOWED_ORIGINS=https://paxis-ai.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# Set to True to also allow generated Vercel preview subdomains.
CORS_ALLOW_VERCEL_PREVIEWS=False

# --- External-call budgets --------------------------------------------------
GEMINI_TIMEOUT_MS=45000
GEMINI_RETRY_ATTEMPTS=2
GEMINI_RETRY_INITIAL_DELAY=0.5
GEMINI_RETRY_MAX_DELAY=4.0
GROQ_TIMEOUT_SECONDS=30.0
GROQ_RETRY_ATTEMPTS=1
SERPER_TIMEOUT_SECONDS=8.0
SERPER_RESULTS_PER_QUERY=5
SERPER_MAX_CONCURRENCY=4
SERPER_MAX_TOPICS=12

# --- Server (read by backend/gunicorn.conf.py) ------------------------------
WEB_CONCURRENCY=1
GUNICORN_THREADS=4
GUNICORN_WORKER_CLASS=gthread
GUNICORN_TIMEOUT=120
GUNICORN_MAX_REQUESTS=400